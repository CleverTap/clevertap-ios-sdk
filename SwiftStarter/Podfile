
platform :ios, '15.0'

target 'SwiftStarter' do
  
  use_frameworks!
  
  pod 'CleverTap-iOS-SDK', :path =>'../'
  
  target 'NotificationService' do
    pod 'CTNotificationService'
  end
  
  target 'SwiftStarterTests' do
    inherit! :search_paths
    # Pods for testing
  end
  
  target 'SwiftStarterUITests' do
    inherit! :search_paths
    # Pods for testing
  end
  
  target 'SwiftTvOS' do
    platform :tvos, '15.0'
    pod 'CleverTap-iOS-SDK', :path =>'../'
  end
  
  target 'SwiftWatchOS Extension' do
    platform :watchos, '9.0'
    pod 'CleverTapWatchOS', :path =>'../'
  end
  
  post_install do |installer_representation|
    installer_representation.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        # Xcode 27 rejects deployment targets below iOS 15; some pods still declare 9.0/10.0.
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
  
end
