
platform :ios, '15.0'

target 'ObjCStarter' do
  
  use_frameworks!

  # Pods for ObjCStarter
  pod 'CleverTap-iOS-SDK', :path =>'../'

  target 'ObjCStarterTests' do
    inherit! :search_paths
    # Pods for testing
  end

  target 'ObjCStarterUITests' do
    inherit! :search_paths
    # Pods for testing
  end
  
  target 'ObjCTvOS' do
      platform :tvos, '15.0'
      pod 'CleverTap-iOS-SDK', :path =>'../'
  end

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Xcode 27 rejects deployment targets below iOS 15; some pods still declare 9.0/10.0.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
