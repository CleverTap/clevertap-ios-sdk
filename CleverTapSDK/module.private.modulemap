// module.private.modulemap
// Exposes internal SDK headers to Swift source files within the CleverTapSDK
// framework via @_implementationOnly import CleverTapSDK.Private.
// These types are NOT part of the public API — clients who import CleverTapSDK
// will never see them. The explicit keyword ensures this submodule is not
// loaded automatically when CleverTapSDK is imported.

explicit module CleverTapSDK.Private {
    header "CTPreferences.h"
    header "CTUIUtils.h"
    header "CTValidationConfig.h"
    header "CleverTapInstanceConfigPrivate.h"
    header "CTConstants.h"
    header "CTQueueType.h"
    header "CTSwitchUserDelegate.h"
    header "CTClock.h"
    header "CTAttachToBatchHeaderDelegate.h"
    header "CTBatchSentDelegate.h"
    header "CTMultiDelegateManager.h"
    header "CTImpressionManager.h"
    export *
}
